          "expr": "{namespace=~\"$namespace\", workload=~\"$workload\", pod=~\"$pod\", container=~\"$container\", node=~\"$node\"} |~ \"(?i)$search\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Logs",
      "type": "logs"
    }
